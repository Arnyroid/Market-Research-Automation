# ═══════════════════════════════════════════════════════════════════
#  Notification channels
#  Set NOTIFY_CHANNELS to any comma-separated combination of:
#    ntfy, telegram, email, whatsapp
#  All listed channels fire independently on each alert.
# ═══════════════════════════════════════════════════════════════════
NOTIFY_CHANNELS=ntfy


# ── PRIMARY: ntfy.sh ──────────────────────────────────────────────
# Zero-signup, free, open-source push notifications.
# No account, no bot setup, no API key — just an app and a topic name.
#
# Setup (under 2 minutes):
#   1. Install the ntfy app → https://ntfy.sh
#        Android: Play Store or F-Droid
#        iOS:     App Store
#   2. Open the app → tap "+" → Subscribe to topic
#   3. Type a topic name that's hard to guess, e.g. "stocks-xk92bz4m"
#      (anyone who knows your topic can send you messages, so keep it private)
#   4. Paste the same name below
#
# That's it — alerts will appear as push notifications on your phone.
#
# Optional: change NTFY_PRIORITY to "urgent" for banner + sound on lock screen
# Optional: self-host by changing NTFY_SERVER to your own instance URL
# Optional: set NTFY_TOKEN if your ntfy server requires auth (public doesn't)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_PRIORITY=high
# NTFY_TOKEN=


# ── OPTIONAL: Telegram ────────────────────────────────────────────
# Good alternative if you're already on Telegram.
# Setup:
#   1. Message @BotFather → /newbot → copy the token
#   2. Message your new bot once (any text)
#   3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates
#      copy the "id" value inside "chat"
# NOTIFY_CHANNELS=ntfy,telegram   ← add telegram to use both
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ── OPTIONAL: Email (SMTP) ────────────────────────────────────────
# Gmail: Google Account → Security → 2FA → App Passwords → generate one
# Outlook: SMTP_HOST=smtp-mail.outlook.com, SMTP_PORT=587
# NOTIFY_CHANNELS=ntfy,email   ← add email to use both
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=


# ── OPTIONAL: WhatsApp (via Twilio) ──────────────────────────────
# Free sandbox at https://twilio.com (no credit card needed).
# FROM = whatsapp:+14155238886  (Twilio sandbox number)
# TO   = whatsapp:+91XXXXXXXXXX (your WhatsApp number with country code)
# NOTIFY_CHANNELS=ntfy,whatsapp   ← add whatsapp to use both
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=


# ═══════════════════════════════════════════════════════════════════
#  AI (Google Gemini — free tier available)
#  1. Go to https://aistudio.google.com/app/apikey
#  2. Click "Create API key" — no billing required for free tier
#  3. Paste the key below
#
#  Free-tier limits (as of 2025): 15 req/min, 1,500 req/day on Flash
#  Model names require the "models/" prefix (new SDK requirement)
#  GEMINI_MODEL_FALLBACK is used automatically when the primary returns 503
# ═══════════════════════════════════════════════════════════════════
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-flash-latest
GEMINI_MODEL_FALLBACK=models/gemini-flash-lite-latest

# ═══════════════════════════════════════════════════════════════════
#  Market data polling
# ═══════════════════════════════════════════════════════════════════
# How often (minutes) to fetch prices during market hours (9:15–15:30 IST)
PRICE_POLL_INTERVAL_MINUTES=5

# How many days after an AI analysis to evaluate the outcome
AGENT_FEEDBACK_DAYS=7


# ═══════════════════════════════════════════════════════════════════
#  CORS (React dev server — usually no need to change)
#  Comma-separated list of allowed origins (no spaces, no brackets)
# ═══════════════════════════════════════════════════════════════════
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
